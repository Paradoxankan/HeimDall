generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  EXECUTIVE
  HR
  MANAGER
  EMPLOYEE
}

enum Status {
  TODO
  PROGRESS
  BLOCKED
  DONE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  title         String?        // Professional headline
  city          String?
  joinedAt      DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  membership    Membership?
  createdOrgs   Organization[] @relation("CreatedOrganizations")
  addedMembers  Membership[]   @relation("AddedMemberships")
  sentInvites   Invitation[]   @relation("SentInvitations")
  ownedTasks    Task[]         @relation("OwnedTasks")
  assignedTasks Task[]         @relation("AssignedTasks")
  leave         LeaveRequest[]
  activity      Activity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  createdById String
  createdBy   User           @relation("CreatedOrganizations", fields: [createdById], references: [id], onDelete: Cascade)
  plan        String         @default("STARTER")
  createdAt   DateTime       @default(now())
  members     Membership[]
  invitations Invitation[]
  projects    Project[]
  tasks       Task[]
  leave       LeaveRequest[]
  activity    Activity[]
  risks       Risk[]
  contracts   Contract[]
  revenue     Revenue[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String       @unique
  // TRADEOFF: Enforcing @unique on userId restricts a user to belong to only ONE organization at a time for now.
  // Tradeoff details:
  // - Pro: Simplifies authorization, eliminates ambiguity over active tenant context, and prevents cross-tenant data leaks during MVP.
  // - Con: Users cannot concurrently belong to multiple organizations (e.g. contractors/consultants) without removing this constraint.
  // To support multiple organizations per user in the future, remove @unique on userId and rely solely on @@unique([userId, organizationId]).
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(EMPLOYEE)
  createdAt      DateTime     @default(now())
  addedById      String?
  addedBy        User?        @relation("AddedMemberships", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String           // Stored lowercase
  role           Role             @default(EMPLOYEE)
  token          String           @unique @default(cuid())
  invitedById    String?
  invitedBy      User?            @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  expiresAt      DateTime

  @@index([email])
  @@index([organizationId])
}

model Project {
  id             String       @id @default(cuid())
  name           String
  sub            String
  status         String
  pct            Int
  team           Int
  lead           String
  milestone      String
  deadline       DateTime
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Task {
  id             String        @id @default(cuid())
  title          String
  desc           String        @default("")
  priority       String
  due            DateTime
  status         Status        @default(TODO)
  progress       Int           @default(0)
  reason         String?
  organizationId String?       // null indicates a personal task
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String        // Owner of the task (always required)
  owner          User          @relation("OwnedTasks", fields: [ownerId], references: [id], onDelete: Cascade)
  assigneeId     String?       // Optional assignee for company tasks
  assignee       User?         @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  projectId      String?       // Optional: personal tasks do not require an org project
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([ownerId])
  @@index([assigneeId])
  @@index([projectId])
}

model Activity {
  id             String       @id @default(cuid())
  who            String
  what           String
  target         String
  at             DateTime     @default(now())
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model LeaveRequest {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  from           DateTime
  to             DateTime
  status         String       @default("PENDING")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model Risk {
  id             String       @id @default(cuid())
  level          String
  title          String
  detail         String
  dept           String
  next           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Contract {
  id             String       @id @default(cuid())
  name           String
  due            DateTime
  note           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Revenue {
  id             String       @id @default(cuid())
  month          String
  product        Int
  services       Int
  sales          Int
  order          Int
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
