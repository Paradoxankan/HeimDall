generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  EMPLOYEE
  MANAGER
  HR
  EXECUTIVE
}

enum Status {
  TODO
  PROGRESS
  BLOCKED
  DONE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model User {
  id              String          @id @default(cuid())
  name            String?
  email           String?         @unique
  emailVerified   DateTime?
  image           String?
  role            Role            @default(EMPLOYEE)
  title           String?
  dept            String?
  city            String?
  joinedAt        DateTime        @default(now())
  onLeave         Boolean         @default(false)
  activeCompanyId String?
  accounts        Account[]
  sessions        Session[]
  memberships     CompanyMember[]
  sentInvitations Invitation[]    @relation("SentInvitations")
  tasks           Task[]
  leave           LeaveRequest[]
  activity        Activity[]
}

model Company {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  logo        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     CompanyMember[]
  invitations Invitation[]
  projects    Project[]
  tasks       Task[]
  leave       LeaveRequest[]
  activity    Activity[]
  risks       Risk[]
  contracts   Contract[]
  revenue     Revenue[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @default(EMPLOYEE)
  title     String?
  dept      String?
  joinedAt  DateTime @default(now())

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

model Invitation {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        Role             @default(EMPLOYEE)
  token       String           @unique @default(cuid())
  status      InvitationStatus @default(PENDING)
  invitedById String?
  invitedBy   User?            @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  expiresAt   DateTime

  @@index([email])
  @@index([companyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id        String   @id @default(cuid())
  name      String   @unique
  sub       String
  status    String
  pct       Int
  team      Int
  lead      String
  milestone String
  deadline  DateTime
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([companyId])
}

model Task {
  id         String   @id @default(cuid())
  title      String
  desc       String   @default("")
  priority   String
  due        DateTime
  status     Status   @default(TODO)
  progress   Int      @default(0)
  reason     String?
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([companyId])
}

model Activity {
  id        String   @id @default(cuid())
  who       String
  what      String
  target    String
  at        DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
}

model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  from      DateTime
  to        DateTime
  status    String   @default("PENDING")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Risk {
  id        String   @id @default(cuid())
  level     String
  title     String
  detail    String
  dept      String
  next      String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Contract {
  id        String   @id @default(cuid())
  name      String
  due       DateTime
  note      String
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Revenue {
  id        String   @id @default(cuid())
  month     String
  product   Int
  services  Int
  sales     Int
  order     Int
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
