# Postgres (Vercel Storage > Neon adds these automatically)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that become Executive on first sign-in
ADMIN_EMAILS=

# AI Contract Intelligence ("anthropic" or "gemini", defaults to "anthropic")
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
